# Copy to .env (and never commit the real .env) or export these manually.

# SQLite is the default and needs no extra setup:
# DATABASE_URL=sqlite:///au_ledger.db
# To use the Postgres from the repo-root docker-compose.yml instead:
# DATABASE_URL=postgresql+psycopg2://au:au_local_only@localhost:5432/au_assignment

# Required secrets (never hardcode these). Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
AU_HMAC_KEY=
#   python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
AU_ENCRYPTION_KEY=
